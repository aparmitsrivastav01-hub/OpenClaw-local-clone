#!/usr/bin/env bun
# OpenClaw environment — copy to .env and adjust

# ── Ollama (required) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# ── Optional web tools (Plan / Ask) ─────────────────────────────────────────
# FIRECRAWL_API_KEY=

# ── Voice (optional) ────────────────────────────────────────────────────────
# VOICE_ENABLED=1
# VOICE_STT_PROVIDER=faster-whisper
# VOICE_TTS_PROVIDER=piper
# VOICE_RECORDER=node
# VOICE_PLAYBACK=node
# VOICE_DSHOW_DEVICE=audio=Microphone (Your Device Name)

# Piper TTS (default local provider — see PIPER_SETUP.md)
# PIPER_PATH=voice/piper/piper.exe
# PIPER_VOICE_MODEL=voice/piper/voices/en_US-lessac-medium.onnx

# Faster-Whisper STT
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# VOICE_PYTHON=python

# Optional cloud TTS (only if VOICE_TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
